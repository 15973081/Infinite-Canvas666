{
  "name": "infinite-canvas-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.spike.config.ts && vite build --config vite.site.config.ts",
    "check": "npm run typecheck && npm run test && npm run build && npm run e2e",
    "e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@xyflow/react": "12.11.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  }
}
