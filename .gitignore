
# Isolated cloud simulation (secrets, database and objects)
.local/

# Local backups, smoke reports and tooling caches
*.dump
*.log
local-smoke.json
.codegraph/
.reasonix/

# Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local dependency environments
.venv/
node_modules/

# Local editor workspace settings
.idea/

# 本地配置和运行数据
/API/.env
/assets/
/data/
/history.json

# 浏览器测试结果
/frontend/test-results/

# 本地安装的 Python 依赖和工具
/python/Lib/site-packages/
/python/Scripts/
/python/share/

# 本地验收截图，保留 output 下其他类型的正式交付物
/output/**/*.png
/output/**/*.jpg

# 本地工具配置与未引用样式草稿
/reasonix.toml
/static/css/smart-shadoxai.css
