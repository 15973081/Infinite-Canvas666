# Copy outside source control. Select with STORAGE_ENV_FILE; process env wins.
DATABASE_BACKEND=postgres
DATABASE_URL=postgresql://canvas_app:CHANGE_ME@127.0.0.1:5432/canvas
DATABASE_SCHEMA=canvas_cloud
DATABASE_POOL_SIZE=10
DEFAULT_WORKSPACE_ID=default

# For a real private TOS bucket: enable versioning before uploading.
MEDIA_BACKEND=tos
TOS_REGION=cn-beijing
TOS_BUCKET=CHANGE_ME
TOS_INTERNAL_ENDPOINT=https://CHANGE_ME
TOS_PUBLIC_ENDPOINT=https://CHANGE_ME
TOS_ACCESS_KEY=CHANGE_ME
TOS_SECRET_KEY=CHANGE_ME
# TOS_SECURITY_TOKEN=optional_STS_token

MEDIA_TEMP_DIR=/var/lib/infinite-canvas/tmp
MEDIA_TEMP_MAX_BYTES=10737418240
MEDIA_MAX_FILE_BYTES=2147483648
MEDIA_BROWSER_URL_TTL=300
MEDIA_PROVIDER_URL_TTL=3600

# Login page credentials for the shared workspace (not separate user accounts).
# AUTH_DB_PATH=/var/lib/infinite-canvas/auth.sqlite3
# See docs/login.md for local setup, sessions and account recovery.
CLOUD_ACCESS_USER=canvas
CLOUD_ACCESS_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
PUBLIC_BASE_URL=https://canvas.example.com
SERVER_HOST=127.0.0.1
SERVER_PORT=6004
CLOUD_EMBEDDED_WORKER=true
CLOUD_WORKER_CONCURRENCY=2

# Local simulation instead of TOS (cloud_local.py init generates these):
# MEDIA_BACKEND=filesystem
# OBJECT_STORE_ROOT=D:/project/Infinite-Canvas666/.local/cloud/objects
# MEDIA_SIGNING_KEY=CHANGE_TO_AT_LEAST_32_RANDOM_CHARACTERS
